# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Agent LLM ---
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_GENAI_USE_ENTERPRISE=False

# OpenAI is optional. Set EDGEONE_LLM_PROVIDER=openai below to use it.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# --- Tencent Cloud EdgeOne credentials (real_tools/_client.py) ---
# Create an API key pair: https://console.tencentcloud.com/cam/capi
TENCENTCLOUD_SECRET_ID=YOUR_TENCENTCLOUD_SECRET_ID
TENCENTCLOUD_SECRET_KEY=YOUR_TENCENTCLOUD_SECRET_KEY
# TENCENTCLOUD_TOKEN=            # only set if using temporary/STS credentials

# --- EdgeOne API endpoint (defaults are for the international product) ---
# Mainland China account? use: teo.tencentcloudapi.com
EDGEONE_ENDPOINT=teo.intl.tencentcloudapi.com
EDGEONE_API_VERSION=2022-09-01
# EDGEONE_REGION=                # most EdgeOne actions don't need this

# --- Which LLM powers the agents ---
# Default is Gemini. Set to `openai` to wrap the configured models with ADK's
# LiteLLM integration. This requires OPENAI_API_KEY and the LiteLLM package.
EDGEONE_LLM_PROVIDER=gemini
EDGEONE_AGENT_MODEL=gemini-flash-latest
# EDGEONE_ORCHESTRATOR_MODEL=gemini-flash-latest   # defaults to EDGEONE_AGENT_MODEL if unset
# INCIDENT_RESPONSE_MODEL=gemini-flash-latest      # defaults to EDGEONE_AGENT_MODEL if unset
#
# OpenAI example:
# EDGEONE_LLM_PROVIDER=openai
# EDGEONE_AGENT_MODEL=gpt-5-mini
# EDGEONE_ORCHESTRATOR_MODEL=gpt-5-mini
# INCIDENT_RESPONSE_MODEL=gpt-5-mini

# --- FastAPI / AG-UI serving layer ---
PORT=8000
# Comma-separated origins allowed to call the REST API directly (the AG-UI
# endpoint is normally only called server-to-server by copilot-runtime, not
# the browser, so this mainly matters for /api/* and for local testing).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
ADK_APP_NAME=edgeone_platform
ADK_DEFAULT_USER_ID=demo_user
ADK_SESSION_TIMEOUT_SECONDS=3600

# --- Stage 1: TCOP alarm callback / incident persistence ---
# The default database is backend/data/edgeone_platform.sqlite3. Set an
# absolute production path (or replace the Stage 1 SQLite store with Postgres).
# EDGEONE_APP_DB_PATH=/var/lib/edgeone-platform/edgeone_platform.sqlite3
#
# TCOP callback endpoint: POST /api/webhooks/tcop/alarm
# Source IPs are dynamic. In production require a high-entropy token in the
# callback URL and, when the TCOP account supports it, Basic Auth as well.
TCOP_CALLBACK_AUTH_REQUIRED=false
# TCOP_CALLBACK_TOKEN=replace-with-a-long-random-secret
# TCOP_CALLBACK_BASIC_AUTH_USER=edgeone-tcop
# TCOP_CALLBACK_BASIC_AUTH_PASSWORD=replace-with-a-long-random-secret

# --- Read-only TCOP alarm-history reconciliation ---
# Disabled by default. When enabled, an operator can POST to
# /api/incidents/reconcile?lookback_minutes=180. The run only records
# callback/history mismatches; it never creates jobs or changes EdgeOne.
TCOP_RECONCILIATION_ENABLED=false
TCOP_MONITOR_ENDPOINT=monitor.intl.tencentcloudapi.com
TCOP_MONITOR_API_VERSION=2018-07-24
TCOP_RECONCILIATION_TIMEOUT_SECONDS=15

# --- Phase 3: operator-triggered read-only investigation worker ---
# Disabled by default. When enabled, POST /api/incidents/jobs/run-once leases
# one queued job and calls only read-only EdgeOne APIs. It cannot remediate.
INCIDENT_WORKER_ENABLED=false

# Read-only fallback when the top-N client-IP analytics result is not ready.
# It asks EdgeOne for up to three L7 offline-log archives in the incident
# window, then retains only aggregate public-IP counts. Set false to disable.
INCIDENT_L7_LOG_FALLBACK_ENABLED=true

# Final guard for approved, write-capable remediation. Leave false for the
# demo until a human has reviewed a specific recommendation and is ready to
# make the live change through the separate execute endpoint.
INCIDENT_REMEDIATION_ENABLED=false

# Server-side kill switch for the future, tightly allowlisted proactive
# incident-demo workflow. The UI cannot enable autonomy unless this is true.
INCIDENT_PROACTIVE_DEMO_ENABLED=false

# Enables the restricted, advisory-only ADK Incident Response Team after a
# qualified dry run. It has no EdgeOne mutation tools.
INCIDENT_PROACTIVE_AGENT_ENABLED=false

# Allows a qualified proactive demo block-IP recommendation to move from draft
# to approved automatically. It does NOT execute any EdgeOne change.
INCIDENT_PROACTIVE_AUTO_APPROVE_ENABLED=false

# Final demo-only gate: permits the deterministic executor to apply a
# proactive auto-approved IP-block recommendation. INCIDENT_REMEDIATION_ENABLED
# must also be true. Leave both false outside the isolated demo.
INCIDENT_PROACTIVE_AUTO_EXECUTE_ENABLED=false

# Demo-only in-process worker. With the persisted Proactive Agent Team toggle
# on, it consumes queued incident jobs without clicking Run investigation.
INCIDENT_PROACTIVE_WORKER_ENABLED=false
INCIDENT_PROACTIVE_WORKER_POLL_SECONDS=2

# Proactive evidence collection starts immediately. If a read-only
# investigation finds no valid client IP, the worker schedules bounded delayed
# rechecks; no initial reporting-delay setting is required.
