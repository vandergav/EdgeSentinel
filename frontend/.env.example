# Copy to .env in this directory (Vite only exposes vars prefixed VITE_).

# The copilot-runtime bridge, not the FastAPI backend directly.
VITE_COPILOT_RUNTIME_URL=http://localhost:3001/api/copilotkit

# Must match copilot-runtime's AGENT_ID and the name ADKAgent registers.
VITE_AGENT_ID=edgeone_agent

# For future phases' direct REST calls (dashboard, incidents, settings) —
# unused by the chat page, which only talks to VITE_COPILOT_RUNTIME_URL.
VITE_BACKEND_API_URL=http://localhost:8000
