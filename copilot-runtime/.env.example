# Copy to .env in this directory.

# Port this bridge listens on (the frontend's VITE_COPILOT_RUNTIME_URL should
# point at http://localhost:<PORT>/api/copilotkit)
PORT=3001

# Where the FastAPI backend's AG-UI endpoint is (backend/app/server.py mounts
# it at /agui) — this is a server-to-server call, never exposed to the browser.
AGENT_BACKEND_URL=http://localhost:8000/agui

# Must match the agent id the frontend's CopilotKit provider uses
# (frontend/.env.example: VITE_AGENT_ID)
AGENT_ID=edgeone_agent

# Comma-separated origins allowed to call this bridge from the browser
ALLOWED_ORIGINS=http://localhost:5173
